# Copy to backend/.env  (backend/.env is git-ignored - NEVER commit real keys).
# Everything here is optional except the two API keys you want to use.
# Values shown are the built-in defaults; uncomment a line only to change it.

# --- Mode & network ---
# local (default, real use) | demo (hosted demo, synthetic data only)
# APP_MODE=local
# APP_HOST=127.0.0.1
# APP_PORT=8000
# DB_PATH=
# DATA_DIR=
# FRONTEND_DIR=
# LOG_LEVEL=INFO
# FRONTEND_ORIGINS=
# EXTENSION_ID=njcikckghkmmanpggmefpbicpllfmegm
# EXTENSION_ORIGIN=
# ALLOWED_HOSTS=

# --- Demo mode (synthetic data only) ---
# DEMO_PUBLIC_TOKEN=True
# DEMO_API_TOKEN=demo-token-synthetic-data-only
# DEMO_ALLOW_INGEST=False
# DEMO_ASK_PER_HOUR=20

# --- Groq: keys, models, limits (verify model names against Groq's current model list) ---
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# NOTE: model ids change; check https://console.groq.com/docs/models and set a live one.
# GROQ_LIVE_MODEL=qwen/qwen3.8-27b
# GROQ_ANALYSIS_MODEL=llama-3.3-70b-versatile
# GROQ_AGENT_MODEL=llama-3.3-70b-versatile
# GROQ_RPM=30
# GROQ_TPM=6000
# GROQ_TPD=500000
# GROQ_SUPERVISOR_RESERVE_TOKENS=50000
# GROQ_DAILY_SHARE_ANALYSIS=0.85
# GROQ_DAILY_SHARE_MONTHLY=0.70
# GROQ_MAX_RETRIES=3
# GROQ_MAX_WAIT_SECONDS=30.0
# GROQ_TIMEOUT_SECONDS=60.0
# GROQ_LIVE_EXTRA_JSON={}
# GROQ_BREAKER_THRESHOLD=4
# GROQ_BREAKER_COOLDOWN_SECONDS=300.0

# --- Gemini (history bootstrap only) ---
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# NOTE: check Google's current model list; any Gemini model with JSON output works.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_RPM=10
# GEMINI_CHUNK_ITEMS=80
# GEMINI_CHUNK_CHARS=9000
# GEMINI_MAX_RETRIES=3
# GEMINI_TIMEOUT_SECONDS=60.0

# --- Classification ---
# CLASSIFY_MAX_ATTEMPTS=5
# CLASSIFY_WORKER_INTERVAL_SECONDS=20.0
# LIVE_BATCH_TOKENS=1800
# LIVE_BATCH_MAX_ITEMS=40
# CACHE_MIN_CONFIDENCE=0.7
# CLASSIFY_MIN_CONFIDENCE=0.35
# PRIOR_MIN_SESSIONS=5
# PRIOR_MIN_SHARE=0.85
# WORKER_BACKOFF_BASE_SECONDS=30.0
# WORKER_BACKOFF_MAX_SECONDS=900.0

# --- Wasted-time rules (decided per session, never per page) ---
# WASTE_MIN_SECONDS=180
# WASTE_MIN_CONFIDENCE=0.7
# WASTE_LONG_SECONDS=1200
# WORK_START_HOUR=9
# WORK_END_HOUR=18

# --- History bootstrap ---
# HISTORY_DAYS=60
# OPTIONAL. Normally leave unset: on first run the website LISTS your Chrome profiles and you pick one
# (nothing is imported or guessed). Setting this forces one history file and skips the chooser.
# chrome://version -> 'Profile Path', then add \History, e.g.
# CHROME_HISTORY_PATH=C:\Users\YOU\AppData\Local\Google\Chrome\User Data\Profile 2\History
# (a profile FOLDER path is also accepted)
# CHROME_HISTORY_PATH=
# HISTORY_ESTIMATE_CAP_SECONDS=300
# HISTORY_IDLE_GAP_SECONDS=1800
# HISTORY_DEFAULT_SECONDS=30
# HISTORY_MAX_VISIT_SECONDS=1800
# HISTORY_MERGE_GAP_SECONDS=30
# HISTORY_CHUNK_DAYS=7

# --- Analysis & catch-up ---
# ANALYSIS_BATCH_TOKENS=3000
# ANALYSIS_MAX_DAYS_PER_RUN=3
# CATCHUP_INTERVAL_MINUTES=45.0

# --- Supervisor agent ---
# AGENT_MAX_STEPS=5
# AGENT_TOOL_RESULT_CHARS=3500
# AGENT_MAX_TOKENS=600

# --- Privacy ---
# Comma-separated; REPLACES the built-in banking/mail/health/password-manager list. Leave unset for the defaults.
# SENSITIVE_DOMAINS=
# TITLE_MAX_CHARS=120
ASK_MAX_WAIT_SECONDS=300
GEMINI_PAUSE_BASE_MINUTES=15
GEMINI_PAUSE_MAX_MINUTES=180