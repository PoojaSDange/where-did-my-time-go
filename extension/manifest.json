{
  "manifest_version": 3,
  "name": "Where Did My Time Go? - Tracker",
  "version": "1.0.0",
  "description": "Measures your active browsing time and sends it ONLY to your own local backend (localhost).",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "storage", "alarms", "idle"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Where Did My Time Go?" }
}
